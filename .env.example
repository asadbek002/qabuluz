# ---- Admin panel ----
# At least 12 characters. Generate one with: openssl rand -base64 24
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Host port the app listens on (bound to 127.0.0.1, put Nginx in front).
APP_PORT=3010

# ---- Database: default compose.yml (bundled PostgreSQL) ----
POSTGRES_USER=university_apply
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=university_apply

# ---- Database: compose.external-db.yml (existing PostgreSQL container) ----
# Docker network shared with your PostgreSQL container; find it with `docker network ls`.
# POSTGRES_DOCKER_NETWORK=your_postgres_network
# Use the PostgreSQL container name/service alias as the hostname.
# DATABASE_URL=postgres://university_apply:CHANGE_ME@postgres:5432/university_apply

# Set to false only when testing over plain HTTP (without HTTPS) — never in production.
# COOKIE_SECURE=false
